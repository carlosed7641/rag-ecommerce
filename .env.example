# Copia este archivo como .env.local y rellena los valores reales.
# .env.local nunca se commitea (ver .gitignore).

# Supabase → Project Settings → API keys (usar las nuevas, no las "Legacy")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic → console.anthropic.com
ANTHROPIC_API_KEY=

# Voyage AI → dash.voyageai.com
VOYAGE_API_KEY=
